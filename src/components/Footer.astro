---
import { CROSS_LINK, SITE_NAME, IS_COM, CC_TAGLINE } from '../config/site';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap">
    {IS_COM ? (
      <div class="cols">
        <div>
          <div class="logo" style="color:#fff;font-weight:800;font-size:18px;">{SITE_NAME}</div>
          <p class="creed" style="margin-top:10px;">
            把复杂的问题拆清楚，<br />把重要的选择想明白。
          </p>
        </div>
        <div>
          <div class="muted">微信</div>
          <div style="margin:4px 0 14px;font-size:16px;font-weight:600;">cc_fudan <span class="muted" style="font-weight:400;">（备注「咨询」）</span></div>
          <a class="work-link" href="/contact#wechat">查看微信二维码 →</a>
        </div>
        <div>
          <div class="muted">真实 · 适配 · 边界清晰</div>
          <p class="creed" style="margin-top:8px;">
            先了解需求，再确认协作。<br />说明范围、费用与利益关系。<br />尊重你的判断与选择。
          </p>
        </div>
      </div>
    ) : (
      <div class="cols cols-cc">
        <div>
          <div class="logo" style="color:#fff;font-weight:800;font-size:18px;">{SITE_NAME}</div>
          <p class="creed" style="margin-top:10px;">
            {CC_TAGLINE}。<br />
            这里只记录生活，不谈获客。
          </p>
        </div>
      </div>
    )}
    <div class="bottom">
      © {year} {SITE_NAME}　·　<a href={CROSS_LINK.href} style="color:inherit;opacity:.7;text-decoration:underline;text-underline-offset:3px;">{CROSS_LINK.label}</a>
    </div>
  </div>
</footer>
