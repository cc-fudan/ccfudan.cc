---
import BaseLayout from '../../layouts/BaseLayout.astro';

// ---------------------------------------------------------------------------
// 资质凭证页 · 对外站专属（仅 SITE_TARGET=com 构建）
//
// 三条写作红线（评审依据，勿破）：
//   1. 每项资质必须配一句「它能为你做什么」，禁止写成「我多厉害」；
//   2. 每项核心资质尽量给「可核验入口」，可核验 > 会炫；
//   3. 港险相关内容一律低调：不出现保诚、不出现港险销售/代理表述
//      （内地销售不合规 + 保诚摘牌 + 湾区保险经纪摘牌，均为红线）。
//
// 待补清单（cc 确认后填入，勿凭空编写）：
//   - 证书扫描件（打码版）图片
//   - 明亚执业登记编号与官方查询入口
//   - 理赔案例数据（须已获客户书面授权）
// ---------------------------------------------------------------------------

type Verify = { label: string; url: string } | { label: string; url: null; note: string };

type Cred = {
  name: string;
  short: string;      // 首屏核心卡上的短标签
  ability: string;    // 它能为你做什么
  verify: Verify;
  core?: boolean;     // 是否进首屏
};

const creds: Cred[] = [
  {
    name: '复旦大学 中国哲学 本硕（学士 2017 / 硕士 2020）',
    short: '复旦中哲本硕',
    ability: '把你的模糊焦虑，拆成几个可以回答的具体问题——这是我做方案的第一步。',
    verify: { label: '学历学位可于「学信网」按证书编号核验', url: 'https://www.chsi.com.cn/' },
    core: true,
  },
  {
    name: '国家统一法律职业资格考试 A 证',
    short: '法考 A 证',
    ability: '合同条款、婚姻财产约定、理赔争议的边界在哪，先替你把红线标出来。',
    verify: { label: '法律职业资格可于司法部政务服务平台核验', url: 'https://www.moj.gov.cn/' },
    core: true,
  },
  {
    name: '5 年一线操盘：华为消费者业务管培 → 荣耀销售/产品/零售管理 → 手机分销电商省总经理',
    short: '5 年一线操盘',
    ability: '不只看保单，还看你的收入结构、行业周期与现金流——方案要经得起业务的检验。',
    verify: { label: '任职经历可依据离职证明/在职证明提供，无可公开查询的第三方入口', url: null, note: '如需核验，可在签约前提供原始证明。' },
    core: true,
  },
  {
    name: '明亚保险经纪 · 执业登记',
    short: '独立保险经纪人',
    ability: '不属于任何一家保险公司，全市场横向比价选品——同样保障，先看能不能更便宜。',
    verify: { label: '保险中介从业人员执业登记，可在国家金融监督管理总局「保险中介监管信息系统」按执业证号查询', url: null, note: '执业证号与查询入口待补（cc 确认后填入）。' },
    core: true,
  },
];

const core = creds.filter((c) => c.core);

// 「资质 ↔ 能力 ↔ 你的场景」三段绑定表
const bindings = [
  ['复旦中哲本硕', '结构化拆解与长期学习', '多个方案摆在面前时，帮你把复杂需求拆成可比较的几项'],
  ['法考 A 证', '法律边界判断、契约审查', '婚姻财产约定、合同条款、理赔争议的边界把关'],
  ['5 年销售管理与电商操盘', '业务视角与一线体感', '把保障放进家庭资产与现金流全盘看，而不是孤立卖一张单'],
  ['明亚保险经纪人', '全市场横向选品', '同一保障需求下，横向比较多家保司的条款与费率'],
];

// 机构与合作（低调：只列身份本身，不做 logo 墙、不做背书暗示）
const affiliations = [
  ['明亚保险经纪', '独立保险经纪人（非雇员代理，不代表任何单一保司）'],
  ['香港高才通', '2026 年获批，亲历申请全流程'],
  ['律所实习', '法律实务探索中，法考 A 证落地使用'],
];

// 实效案例：暂不公开（无数据即不展示，绝不编造）
const cases: { type: string; amount: string; duration: string; note: string }[] = [];
---

<BaseLayout
  title="资质凭证 | cc · 程成"
  description="程成（cc）的可核验资质：复旦中哲本硕、法考 A 证、5 年一线操盘、明亚保险经纪人执业登记。每一项都说明它能为你做什么。"
>
  <section class="section">
    <div class="wrap prose">
      <span class="eyebrow">资质凭证</span>
      <h1 class="section-title">他凭什么？</h1>
      <p style="font-size:18px;color:var(--ink);">
        复旦中哲本硕 · 法考 A 证 · 5 年一线操盘 · 独立保险经纪人。<br />
        下面每一项，我都写清两件事：<strong>它怎么被核验</strong>，以及<strong>它能为你做什么</strong>。
      </p>

      <h2>先看这四项</h2>
      <div class="grid-2" style="margin-top:14px;">
        {core.map((c) => (
          <div class="card">
            <h3>{c.short}</h3>
            <p>{c.ability}</p>
            <p class="verify" style="font-size:13px;color:var(--muted);margin-top:10px;">
              {c.verify.url ? (
                <>核验：<a class="work-link" href={c.verify.url} target="_blank" rel="noopener">{c.verify.label}</a></>
              ) : (
                <>核验：{c.verify.label}（{c.verify.note}）</>
              )}
            </p>
          </div>
        ))}
      </div>

      <h2>全量清单</h2>
      <h3 style="font-size:16px;color:var(--muted);margin:18px 0 8px;">学历</h3>
      <ul>
        {creds.filter((c) => c.name.includes('复旦')).map((c) => (
          <li>{c.name} —— {c.ability}</li>
        ))}
      </ul>

      <h3 style="font-size:16px;color:var(--muted);margin:22px 0 8px;">职业资格</h3>
      <ul>
        <li>国家统一法律职业资格考试 A 证 —— 见上，边界与契约审查能力</li>
      </ul>

      <h3 style="font-size:16px;color:var(--muted);margin:22px 0 8px;">机构与合作</h3>
      <ul>
        {affiliations.map(([t, d]) => <li><strong>{t}</strong> —— {d}</li>)}
      </ul>

      <h2>资质 ↔ 能力 ↔ 你的场景</h2>
      <p>证书只是材料，能落到你身上的才是能力。这张表是我对自己的翻译。</p>
      <div class="bindings" style="margin-top:14px;">
        {bindings.map(([q, a, s]) => (
          <div class="binding">
            <div class="b-q">{q}</div>
            <div class="b-a">{a}</div>
            <div class="b-s">{s}</div>
          </div>
        ))}
      </div>

      {cases.length > 0 && (
        <>
          <h2>实效案例</h2>
          <p>以下案例均已获客户书面授权，并做匿名化处理（不出现姓名、公司、可识别信息）。</p>
          <div class="grid-2" style="margin-top:14px;">
            {cases.map((c) => (
              <div class="card">
                <h3>{c.type}</h3>
                <p>金额区间：{c.amount}<br />处理周期：{c.duration}</p>
                <p style="font-size:13px;color:var(--muted);">已获客户授权 · {c.note}</p>
              </div>
            ))}
          </div>
        </>
      )}

      <h2>关于证书原件</h2>
      <p>
        证书扫描件涉及证件号、签名与二维码，本页一律不原样公开。
        如你需要核验，我可以当面/视频出示原件，或提供已打码版本。
      </p>

      <div style="margin-top:34px;">
        <a class="btn btn-primary" href="/contact">带着你的问题来找我 →</a>
      </div>
    </div>
  </section>

  <style>
    .bindings { display: grid; gap: 10px; }
    .binding {
      display: grid;
      grid-template-columns: 200px 1fr 1.2fr;
      gap: 14px;
      padding: 14px 16px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 10px;
      font-size: 15px;
      line-height: 1.7;
    }
    .binding .b-q { font-weight: 700; color: var(--ink); }
    .binding .b-a { color: var(--primary); font-weight: 600; }
    .binding .b-s { color: var(--muted); }
    @media (max-width: 720px) {
      .binding { grid-template-columns: 1fr; gap: 6px; }
    }
  </style>
</BaseLayout>
