---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConsultingProcess from '../../components/ConsultingProcess.astro';
import { consultingAreas } from '../../data/consulting';
---
<BaseLayout title="如何协作 | 程成 cc" description="从具体问题开始，厘清需求、比较路径、形成行动计划。咨询前明确范围、交付、时间和费用，必要时协助连接合适的专业人士。">
  <section class="section advisory-section"><div class="wrap">
    <div class="advisory-page-head"><span class="eyebrow">如何协作</span><h1>从问题出发，<br />找到适合你的帮助。</h1><p class="advisory-lead">可以先说说困惑，不必先决定要买哪一种服务。我们先确认问题、帮助方式与边界。</p></div>
    <div class="advisory-details">{consultingAreas.map(area => <section class="advisory-detail" id={area.id}><div><span class="advisory-number">{area.number}</span><h2>{area.title}</h2><p class="advisory-question">{area.question}</p></div><div><p>{area.desc}</p><ul>{area.points.map(p => <li>{p}</li>)}</ul><p class="advisory-scope"><strong>服务边界</strong><br />{area.scope}</p></div></section>)}</div>
  </div></section>
  <section class="section advisory-section advisory-tint"><div class="wrap"><div class="advisory-heading"><div><span class="eyebrow">从初步交流到具体工作</span><h2>四步确认，一起推进</h2></div></div><ConsultingProcess /></div></section>
  <section class="section advisory-section"><div class="wrap advisory-two-col"><div><span class="eyebrow">费用与交付</span><h2>开始之前，先约定清楚。</h2><p>是否适合协作、具体做哪些工作，需要先了解你的问题。费用依据确认后的服务范围与交付内容说明；你了解并接受后，再决定是否开始。</p></div><div class="advisory-note"><h3>可以先准备这三件事</h3><ol><li>发生了什么，你最想解决哪一个问题？</li><li>目前已经做过什么，手里有哪些信息？</li><li>有哪些时间、预算或其他限制？</li></ol><p>初步交流无需发送证件号、账户密码或无关的个人资料。</p><a class="btn btn-primary" href="/contact#wechat">带着问题来聊聊 ↗</a></div></div></section>
</BaseLayout>
