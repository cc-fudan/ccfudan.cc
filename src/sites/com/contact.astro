---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="联系预约 | cc · 程成" description="保障 / 法律 / 身份 / 职业与 AI 咨询，加微信 cc_fudan（备注「咨询」）。公众号 cc的保险笔记。">
  <section class="section">
    <div class="wrap">
      <span class="eyebrow">联系预约</span>
      <h1 class="section-title">先信任，再聊方案</h1>
      <p class="section-sub">我不主动推销。加好友前，建议先读几篇文章，看看这个顾问怎么想问题，有了基础信任，我们再细说。</p>

      <div class="contact-grid">
        <div class="contact-card">
          <div class="row"><div class="k">微信</div><div class="v">cc_fudan <span style="color:var(--muted);font-weight:400;">（备注「咨询」）</span></div></div>
          <div class="row"><div class="k">咨询范围</div><div class="v">保障规划 / 法律契约 / 身份与跨境规划 / 职业与 AI</div></div>
          <div class="row"><div class="k">公众号</div><div class="v">cc的保险笔记</div></div>
          <div class="row"><div class="k">所在地</div><div class="v">长沙 / 武汉（全国可远程）</div></div>
          <div class="row"><div class="k">同行 / 应聘</div><div class="v">同微信，备注「应聘经纪人」或「同行付费咨询」</div></div>
        </div>
        <div class="contact-card" style="background:var(--primary);color:#fff;border:none;">
          <h3 style="margin-top:0;">约法三章</h3>
          <p style="color:rgba(255,255,255,0.85);">一、不卖我不认可的产品；<br />二、不用我不认可的方式；<br />三、不卖给和我不互相认可的人。</p>
          <p style="color:rgba(255,255,255,0.7);font-size:14px;margin-bottom:0;">
            保障是终身的托付。先了解你，才是负责任。
          </p>
        </div>
      </div>

      <div class="qr-wrap">
        <img class="qr-img" src="/images/wechat-qr.png" alt="微信二维码：cc_fudan" width="240" />
        <p class="qr-cap">微信扫一扫，添加 cc_fudan（备注「咨询」）</p>
      </div>

      <div style="margin-top:30px;">
        <a class="btn btn-primary" href="/writing">先读读我的文章 →</a>
      </div>
    </div>
  </section>
</BaseLayout>
