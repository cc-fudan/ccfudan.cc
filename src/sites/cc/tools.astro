---
import BaseLayout from '../../layouts/BaseLayout.astro';
const tools = [
  { name:'知国公', mark:'公', kind:'选岗 · 决策', href:'/tools/zhiguogong/', download:'/tools/downloads/zhiguogong.html', description:'知国考，也借一个国公的雅号。填入自己的条件，在全国岗位中找到候选，再核对专业原文与报名变化。', tags:['19,426 个岗位','省市联动','专业目录','离线版可下载'], featured:true },
  { name:'砚田', mark:'砚', kind:'写作 · 阅读', href:'/tools/yantian.html', download:'/tools/yantian.html', description:'一方随身的纸墨。写 Markdown、即时预览、整理草稿，把心里想的慢慢写清楚。', tags:['本地草稿','即时排版','导出分享'] },
  { name:'周易问卦', mark:'易', kind:'传统文化 · 自省', href:'/tools/zhouyi.html', download:'/tools/zhouyi.html', description:'蓍草起卦，看看本卦与之卦。作为整理问题与自我观察的一面镜子，传统文化体验，仅供参考。', tags:['离线起卦','本地历史','分享卡片'] },
  { name:'人生计时器', mark:'时', kind:'时间 · 生活', href:'/tools/countdown.html', download:'/tools/countdown.html', description:'用自己设定的时间刻度，看看已经走过和仍待珍惜的日子。只是时间计算，不是个人寿命预测。', tags:['本地计算','可视化时间','自主设定'] },
];
---
<BaseLayout title="小工具 · cc的器物间 | 3C得九" description="cc鼓捣的小工具：知国公、砚田、周易问卦和人生计时器。打开就能用，喜欢也可以下载带走。">
  <section class="tools-hero"><div class="wrap"><span class="eyebrow">CC'S LITTLE WORKSHOP</span><h1>鼓捣点小工具，<br/>让日子顺手一点。</h1><p>有时为了解决一个问题，有时只是好奇。做成了，就放在这里；打开即用，喜欢也可以带走。</p><div class="promise"><span>无需注册</span><span>核心功能本地运行</span><span>不调用模型 API</span></div></div></section>
  <section class="tools-section"><div class="wrap"><div class="tools-grid">{tools.map((tool)=>(
    <article class:list={['tool-card',{featured:tool.featured}]}>
      <div class="tool-top"><span class="tool-mark">{tool.mark}</span><small>{tool.kind}</small>{tool.featured&&<b class="new">新作</b>}</div>
      <h2>{tool.name}</h2><p>{tool.description}</p><div class="tool-tags">{tool.tags.map(t=><span>{t}</span>)}</div>
      <div class="tool-actions"><a class="btn btn-primary" href={tool.href}>打开{tool.name} ↗</a><a class="tool-download" href={tool.download} download>下载离线版 ↓</a></div>
    </article>
  ))}</div><aside class="tools-note"><b>把工具带走，把选择留给自己。</b><p>第一次在线打开需要联网。下载的单文件版可离线使用；个人条件、草稿和收藏保存在自己的浏览器中，换设备前请在工具内导出备份。知国公的资格初筛及人数比较用于辅助核对，以招录机关解释为准。旧工具也会持续改进，复杂排版在电脑上操作更方便。</p></aside></div></section>
</BaseLayout>
<style>
  .tools-hero{padding:72px 0 45px;background:radial-gradient(ellipse at 90% 10%,#d9e5d055,transparent 60%),#f7f4ec;border-bottom:1px solid var(--border)}.tools-hero h1{font-size:clamp(34px,5vw,56px);font-weight:700;line-height:1.35;letter-spacing:-1.5px;margin:6px 0 20px}.tools-hero p{max-width:620px;color:var(--muted);font-size:16px;line-height:1.9}.promise{display:flex;gap:10px;flex-wrap:wrap;margin-top:22px}.promise span{font-size:12px;padding:5px 12px;background:#fff9;border:1px solid #dce4d5;border-radius:20px;color:#52694d}.tools-section{padding:44px 0 70px}.tools-grid{display:grid;grid-template-columns:1fr 1fr;gap:23px}.tool-card{min-width:0;background:var(--surface);border:1px solid var(--border);border-radius:17px;padding:30px;display:flex;flex-direction:column;box-shadow:0 6px 30px #39301804}.tool-card.featured{border-color:#95b29e;background:linear-gradient(145deg,#f1f7ef,#fffdf7)}.tool-top{display:flex;gap:13px;align-items:center}.tool-mark{height:45px;width:45px;border-radius:12px 3px 12px 3px;background:#f0e9dc;color:#7d5132;display:grid;place-items:center;font-size:25px;font-family:'Songti SC','SimSun',serif}.featured .tool-mark{background:#26684f;color:white}.tool-top small{font-size:11px;color:var(--muted);letter-spacing:1px}.new{margin-left:auto;color:#5c7b60;background:#e0eddc;font-size:10px;border-radius:15px;padding:3px 10px}.tool-card h2{font-size:27px;margin:23px 0 12px}.tool-card p{line-height:1.9;color:var(--muted);font-size:14px;margin:0 0 20px}.tool-tags{display:flex;gap:7px;flex-wrap:wrap;margin-top:auto}.tool-tags span{font-size:11px;padding:3px 8px;border:1px solid #e6e7dd;border-radius:5px;color:#7c806f}.tool-actions{display:flex;align-items:center;gap:17px;margin-top:27px;flex-wrap:wrap}.tool-actions .btn{border-radius:8px;background:#306b53;box-shadow:none}.tool-download{font-size:12px;color:#637b63;text-decoration:underline;min-height:44px;display:flex;align-items:center}.tools-note{margin-top:30px;border-top:1px solid var(--border);padding-top:26px;color:#64725f}.tools-note b{font-size:15px}.tools-note p{font-size:12px;line-height:1.9;max-width:880px}@media(max-width:700px){.tools-grid{grid-template-columns:1fr;gap:17px}.tools-hero{padding:38px 0 30px}.tools-hero h1{font-size:33px}.tools-hero p{font-size:14px}.tools-section{padding-top:24px}.tool-card{padding:24px}.tool-actions .btn{min-height:46px}.tool-card h2{margin-top:20px}.tools-note{margin-top:25px}}
</style>
