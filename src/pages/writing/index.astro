---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articleArchive } from '../../data/articleArchive';
import { IS_COM } from '../../config/site';

const posts = await articleArchive();
---

<BaseLayout
  title={IS_COM ? '文章观点 | cc · 程成' : '文章合集 | 3C得九'}
  description={IS_COM ? '站内全文文章观点：保险、职业、身份与佛学。' : '程成的文章合集：生活、阅读与思考。'}
>
  <section class="section">
    <div class="wrap">
      <span class="eyebrow">WRITING & NOTES</span>
      <h1 class="section-title">{IS_COM ? '文章观点' : '文章合集'}</h1>
      <p class="section-sub">
        {IS_COM ? '站内全文可直接阅读——先看文章，了解我的思考方式。' : '记录生活，也记录想法如何慢慢变得清楚。'}
      </p>
      <p class="archive-count">共 {posts.length} 篇 · 按发表时间排列 · 有站内全文时优先站内阅读</p>
      <div class="posts article-archive">
        {posts.map((p) => (
          <a class="post" href={p.href} target={p.external ? '_blank' : undefined} rel={p.external ? 'noopener noreferrer' : undefined}>
            <div>
              <div class="meta">{p.date.toISOString().slice(0, 10)} · {p.account} · {p.external ? '公众号原文 ↗' : '站内全文'}</div>
              <h3>{p.title}</h3>
              <p>{p.excerpt}</p>
            </div>
            <div class="arrow">→</div>
          </a>
        ))}
      </div>
      {/* 双站隔离：/works 为 .com 专属（含收费标准），.cc 不出链 */}
      {IS_COM ? (
        <div style="margin-top:28px;">
          <a class="btn btn-ghost" href="/works">更多作品与公众号推文 →</a>
        </div>
      ) : (
        <div style="margin-top:28px;">
          <a class="btn btn-ghost" href="/notes">去书房看随笔 →</a>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
