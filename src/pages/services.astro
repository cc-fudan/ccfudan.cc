---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';

const flow = [
  ['售前 · 需求诊断', '不上来就推产品，先问「你怕什么」。家庭结构、预算、已有保单，全盘梳理保障缺口。'],
  ['售中 · 方案定制', '全市场横向对比，拉表算数，同样保障帮你省 30%–50% 保费，买对不买贵。'],
  ['投保 · 核保协助', '健康告知、智能核保、投保全流程陪同，避免踩坑埋雷。'],
  ['售后 · 保单托管', '已有保单集中管理，定期检视，缺口随人生阶段动态调整。'],
  ['理赔 · 全程协助', '出险第一时间指导报案、备料、跟进，团队累计 400+ 件实战经验为你兜底。'],
];
---

<BaseLayout title="服务咨询 | cc · 程成" description="家庭保障规划、储蓄理财规划、保单检视与托管、理赔协助、法律+保险交叉咨询。明亚保险经纪人 cc 的全流程服务。">
  <section class="section">
    <div class="wrap">
      <span class="eyebrow">服务咨询</span>
      <h1 class="section-title">我能提供什么</h1>
      <p class="section-sub">明亚签约 100+ 家保险公司、上千款产品。我不属于任何一家保司，只从全市场挑最适合你的那一款。</p>

      <div class="grid-3">
        <ServiceCard
          icon="🛡"
          title="家庭保障规划"
          desc="重疾 / 医疗 / 意外 / 寿险，全市场对比，先问需求再定方案。"
          points={["保障缺口诊断", "方案横向对比", "买对不买贵"]}
        />
        <ServiceCard
          icon="🌱"
          title="储蓄理财规划"
          desc="增额终身寿 / 年金 / 教育金 / 养老金，锁定长期利率。"
          points={["现金流规划", "资产隔离与传承", "平稳交棒下一代"]}
        />
        <ServiceCard
          icon="📑"
          title="保单检视与托管"
          desc="已有保单系统梳理，查漏补缺，客观中立说实话。"
          points={["保障缺口复盘", "绝不无脑劝退旧单", "定期动态检视"]}
        />
        <ServiceCard
          icon="🚑"
          title="理赔协助"
          desc="出险全程陪跑，团队累计 400+ 件理赔经验兜底。"
          points={["报案指导", "材料准备跟进", "争议协助沟通"]}
        />
        <ServiceCard
          icon="⚖️"
          title="法律 + 保险交叉咨询"
          desc="法律职业资格加持，把保险放进家庭资产与传承的全盘里看。"
          points={["法律风险视角", "架构与受益设计", "独立第三方意见"]}
        />
        <ServiceCard
          icon="🤝"
          title="同业 / 应聘咨询"
          desc="欢迎全国优秀伙伴全职或兼职加入保险经纪团队。"
          points={["职业路径答疑", "团队资源对接", "付费深度咨询"]}
        />
      </div>

      <h2 class="section-title" style="margin-top:56px;">合作流程</h2>
      <p class="section-sub">售前 → 售中 → 投保 → 售后 → 理赔，全程在你这边。</p>
      <div class="grid-3">
        {flow.map(([t, d]) => (
          <div class="card">
            <h3>{t}</h3>
            <p>{d}</p>
          </div>
        ))}
      </div>

      <h2 class="section-title" style="margin-top:56px;">约法三章</h2>
      <div class="rules">
        <div class="rule"><div class="n">一</div><h4>不卖我不认可的产品</h4><p>无论大公司还是小保司。</p></div>
        <div class="rule"><div class="n">二</div><h4>不用我不认可的方式</h4><p>无套路、不话术、不骚扰。</p></div>
        <div class="rule"><div class="n">三</div><h4>不卖给不互信的人</h4><p>先彼此信任，再谈方案。</p></div>
      </div>

      <div style="margin-top:34px;">
        <a class="btn btn-primary" href="/contact">预约咨询 →</a>
      </div>
    </div>
  </section>
</BaseLayout>
