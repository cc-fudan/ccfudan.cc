---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('writing'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout>
  <!-- HERO -->
  <section class="hero">
    <div class="wrap">
      <div class="hero-grid">
        <div class="hero-copy">
          <div class="eyebrow-stack">
            <span>独立咨询顾问</span>
            <span>AI 元能力</span>
            <span>身份规划</span>
            <span>法律思维</span>
            <span>保险经纪</span>
          </div>
          <h1>先定义问题，<br />再找方案</h1>
          <p class="lead">
            我不是销售。哲学教我拆问题，法律教我划边界，五年一线操盘（4 年消费电子 + 1 年电商省总）教我看业务，AI 实战教我提效率——
            <strong class="lead-tools">保险、法律、身份、职业</strong>，只是工具箱里的四件工具，用哪件，取决于你真正的问题。
          </p>
          <div class="cta-row">
            <a class="btn btn-light" href="/contact">加微信聊聊你的问题</a>
            <a class="btn btn-outline" href="/works">看看这个顾问怎么想</a>
          </div>
        </div>
        <img class="hero-avatar" src="/images/avatar.jpg" alt="程成（cc）头像" width="280" height="280" />
      </div>
      <div class="creds cols-4">
        <a class="cred" href="/about#education">
          <div class="cred-main">A证 · 复旦中哲硕士</div>
          <div class="cred-sub">本硕四证 + 法考证书 · 学习能力</div>
        </a>
        <a class="cred" href="/about#career">
          <div class="cred-main">5 年一线操盘</div>
          <div class="cred-sub">华为管培 / 荣耀 / 能良 / 律所 · 产品 · 大客户 · 区域管理</div>
        </a>
        <a class="cred" href="/family">
          <div class="cred-main">🍼 陪产带娃</div>
          <div class="cred-sub">2026 喜得小犬 · 家庭照片墙 →</div>
        </a>
        <a class="cred" href="/services">
          <div class="cred-main">懂法律的保险经纪</div>
          <div class="cred-sub">100+ 合作保司 · 500+ 理赔案例 · 独立选品</div>
        </a>
      </div>
    </div>
  </section>

  <!-- CONSULTING DOMAINS -->
  <section class="section">
    <div class="wrap">
      <span class="eyebrow">我能帮你做什么</span>
      <h2 class="section-title">一个顾问，四张地图</h2>
      <p class="section-sub">问题域不同，方法一致：先定义问题，再划边界，再对冲风险，最后放大效率——全程站在你这边。</p>
      <div class="grid-2">
        <ServiceCard
          icon="🛡"
          title="家庭风险与保障"
          desc="重疾 / 医疗 / 意外 / 寿险与储蓄传承，全市场横向对比。"
          points={["先问「你怕什么」，再定方案", "同样保障省 30%–50% 保费", "投保只是服务的开始，理赔陪跑到底"]}
        />
        <ServiceCard
          icon="⚖️"
          title="法律与契约思维"
          desc="婚姻财产、契约安排、取证边界的法律视角梳理。"
          points={["法律职业资格（A 证）加持", "把保险放进家庭资产全盘看", "独立第二意见，不和稀泥"]}
        />
        <ServiceCard
          icon="🌏"
          title="香港身份与跨境保障"
          desc="香港高才通申请实操 + 保诚港险代理。"
          points={["高才通全流程亲历经验", "港险与内地配置的互补逻辑", "跨境家庭的一站式规划思路"]}
        />
        <ServiceCard
          icon="🤖"
          title="职业决策与 AI 元能力"
          desc="职业路径对比分析、AI 工作流搭建、人机协同五科目。"
          points={["多方案对比式决策（亲历三地规划）", "AI 协作实战——本站即协作产物", "训练「定义问题」的元能力"]}
        />
      </div>
      <div style="margin-top:28px;">
        <a class="btn btn-ghost" href="/services">查看服务详情 →</a>
      </div>
    </div>
  </section>

  <!-- QUOTE BAND -->
  <section class="section" style="background:var(--primary);color:#fff;">
    <div class="wrap" style="text-align:center;">
      <p style="font-size:22px;font-weight:800;line-height:1.7;margin:0 0 14px;">
        「当 AI 把执行力商品化之后，剩下的稀缺资源只有两个：<br />判断力和信任。」
      </p>
      <p style="font-size:16px;color:rgba(255,255,255,0.85);margin:0;">
        AI 能模拟专业，但模拟不了「在乎」。好顾问不是因为用了正确的方法，
        而是真的在乎你有没有被安排好——这两样，机器都给不了。
      </p>
    </div>
  </section>

  <!-- FEATURED WRITING -->
  <section class="section" style="background:var(--surface);border-top:1px solid var(--border);border-bottom:1px solid var(--border);">
    <div class="wrap">
      <span class="eyebrow">最近在想的事</span>
      <h2 class="section-title">精选文章</h2>
      <p class="section-sub">不急着聊产品，先看几天文章，看看这个顾问怎么想问题。</p>
      <div class="posts">
        {posts.map((p) => (
          <a class="post" href={`/writing/${p.slug}`}>
            <div>
              <div class="meta">{p.data.date.toISOString().slice(0, 10)} · {p.data.tags.join(' / ')}</div>
              <h3>{p.data.title}</h3>
              <p>{p.data.excerpt}</p>
            </div>
            <div class="arrow">→</div>
          </a>
        ))}
      </div>
      <div style="margin-top:24px;">
        <a class="btn btn-ghost" href="/works">全部作品与文章 →</a>
      </div>
    </div>
  </section>

  <!-- ABOUT TEASER -->
  <section class="section">
    <div class="wrap">
      <div class="about-teaser">
        <img class="teaser-avatar" src="/images/avatar.jpg" alt="程成 cc" width="160" height="160" />
        <div class="prose">
        <span class="eyebrow">关于我</span>
        <h2 class="section-title">程成（cc），把复杂的事拆清楚</h2>
        <p>
          1995 年生于武汉。复旦哲学硕士、法律职业资格，五年一线操盘（华为荣耀四年销售管理、电商省总），
          2025 年裸辞回家陪产，过去一年以陪产带娃为主线，把港险、法律、自媒体、AI 都实地试了一遍。现在，我是一个不站队任何机构的独立咨询顾问——
          <strong>你的问题在哪，我的工具箱就开在哪</strong>。
        </p>
        <p>
          我信奉：先定义问题，再找方案；不话术、不骚扰，只忠于客户。
        </p>
        <a class="btn btn-primary" href="/about">更多关于我 →</a>
      </div>
      </div>
    </div>
  </section>
</BaseLayout>
