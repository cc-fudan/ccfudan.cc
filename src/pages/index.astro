---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import {
  IS_COM,
  H1_COM,
  SUB_COM,
  HOME_CARDS_COM,
  CC_TAGLINE,
  CC_HERO_SUB,
  CC_ROOMS,
  CC_LIB_HINT,
  SITE_TARGET,
} from '../config/site';
import { getCollection } from 'astro:content';
// 全家福上的朱砂印（白文：朱底白字），内联零请求
import sealBaiwen from '../assets/brand/seal-jiuer-fumu-baiwen.svg?raw';

// ── .com：精选 3 篇站内全文（职业 / 保险 / 身份） ──────────────────────────
const comPosts = (await getCollection('writing'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

// ── .cc：导流自有文章（与 /notes、/library 同口径，互斥分流） ──────────────
const linkOf = (w: { data: { url?: string; internal?: string } }) =>
  w.data.url ? w.data.url : `/writing/${w.data.internal}`;
const isExternal = (w: { data: { url?: string; internal?: string } }) => Boolean(w.data.url);

const ccWorks = (await getCollection('works'))
  .filter((w) => w.data.target === 'both' || w.data.target === SITE_TARGET)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const ccNotes = ccWorks.filter((w) => !CC_LIB_HINT.test(w.data.title)).slice(0, 3);
const ccLibCount = ccWorks.filter((w) => CC_LIB_HINT.test(w.data.title)).length;
---

{
  IS_COM ? (
    <BaseLayout
      title="cc · 程成 | 独立咨询顾问"
      description="复旦哲学硕士 · 法律职业资格 · 前华为荣耀销售管理。转型期家庭的一次性想清楚：保障 · 契约 · 身份。"
    >
      <!-- HERO -->
      <section class="hero">
        <div class="wrap">
          <div class="hero-grid">
            <div class="hero-copy">
              <div class="eyebrow-row">
                <span>独立咨询顾问</span>
                <span>法律思维</span>
                <span>身份规划</span>
                <span>保险经纪</span>
              </div>
              <h1>{H1_COM}</h1>
              <p class="lead">{SUB_COM}</p>
              <div class="cta-row">
                <a class="btn btn-light" href="/contact">加微信聊聊你的问题</a>
                <a class="btn btn-outline" href="/credentials">看看案例与口碑</a>
              </div>
            </div>
            <img class="hero-avatar" src="/images/avatar.jpg" alt="程成（cc）头像" width="280" height="280" />
          </div>
          <div class="creds cols-4">
            <a class="cred" href="/about#education">
              <div class="cred-main">A证 · 复旦中哲硕士</div>
              <div class="cred-sub">本硕四证 + 法考证书<br />学习能力</div>
            </a>
            <a class="cred" href="/about#career">
              <div class="cred-main">5 年一线操盘</div>
              <div class="cred-sub">华为管培 / 荣耀 / 能良 / 律所<br />产品 · 大客户 · 区域管理</div>
            </a>
            <a class="cred" href="/services">
              <div class="cred-main">懂法律的保险经纪</div>
              <div class="cred-sub">100+ 合作保司 · 团队累计理赔 500+ 件<br />独立选品</div>
            </a>
            <a class="cred" href="/services">
              <div class="cred-main">香港高才通亲历</div>
              <div class="cred-sub">身份与跨境规划<br />合规边界提示</div>
            </a>
          </div>
        </div>
      </section>

      <!-- CONSULTING DOMAINS -->
      <section class="section">
        <div class="wrap">
          <span class="eyebrow">我能帮你做什么</span>
          <h2 class="section-title">一个顾问，四张地图</h2>
          <p class="section-sub">问题域不同，方法一致：先定义问题，再划边界，再对冲风险，最后放大效率——全程站在你这边。</p>
          <div class="grid-2">
            {HOME_CARDS_COM.map((c) => (
              <ServiceCard icon="" title={c.title} desc={c.desc} points={c.points} href={c.href} />
            ))}
          </div>
          <div style="margin-top:28px;">
            <a class="btn btn-ghost" href="/services">查看服务详情 →</a>
          </div>
        </div>
      </section>

      <!-- QUOTE BAND -->
      <section class="section" style="background:var(--primary);color:#fff;">
        <div class="wrap" style="text-align:center;">
          <p style="font-size:22px;font-weight:800;line-height:1.7;margin:0 0 14px;">
            「当 AI 把执行力商品化之后，剩下的稀缺资源只有两个：<br />判断力和信任。」
          </p>
          <p style="font-size:16px;color:rgba(255,255,255,0.85);margin:0;">
            AI 能模拟专业，但模拟不了「在乎」。好顾问不是因为用了正确的方法，
            而是真的在乎你有没有被安排好——这两样，机器都给不了。
          </p>
        </div>
      </section>

      <!-- FEATURED WRITING -->
      <section class="section" style="background:var(--surface);border-top:1px solid var(--border);border-bottom:1px solid var(--border);">
        <div class="wrap">
          <span class="eyebrow">最近在想的事</span>
          <h2 class="section-title">精选文章</h2>
          <p class="section-sub">不急着聊产品，先看几天文章，看看这个顾问怎么想问题。</p>
          <div class="posts">
            {comPosts.map((p) => (
              <a class="post" href={`/writing/${p.slug}`}>
                <div>
                  <div class="meta">{p.data.date.toISOString().slice(0, 10)} · {p.data.tags.join(' / ')}</div>
                  <h3>{p.data.title}</h3>
                  <p>{p.data.excerpt}</p>
                </div>
                <div class="arrow">→</div>
              </a>
            ))}
          </div>
          <div style="margin-top:24px;">
            <a class="btn btn-ghost" href="/works">全部文章（站内全文 + 公众号同步） →</a>
          </div>
        </div>
      </section>

      <!-- ABOUT TEASER -->
      <section class="section">
        <div class="wrap">
          <div class="about-teaser">
            <img class="teaser-avatar" src="/images/avatar.jpg" alt="程成 cc" width="160" height="160" />
            <div class="prose">
              <span class="eyebrow">关于我</span>
              <h2 class="section-title">程成（cc），把复杂的事拆清楚</h2>
              <p>
                1995 年生于武汉。复旦哲学硕士、法律职业资格，五年一线操盘（华为荣耀四年销售管理、电商省总），
                现在是一个不站队任何机构的独立咨询顾问——<strong>你的问题在哪，我的工具箱就开在哪</strong>。
              </p>
              <p>
                我信奉：先定义问题，再找方案；不话术、不骚扰，只忠于客户。
              </p>
              <a class="btn btn-primary" href="/about">更多关于我 →</a>
            </div>
          </div>
        </div>
      </section>
    </BaseLayout>
  ) : (
    <BaseLayout
      title="3C得九 | 程成 · 格物致知 · 修身齐家"
      description="cc 的对内站：书房、茶室、工作室、运动与客厅——一个人格物致知、修身齐家的私人角落。"
    >
      <!-- HERO：宣纸底 + 右全家福 -->
      <section class="hero hero-cc">
        <div class="wrap">
          <div class="hero-grid">
            <div class="hero-copy">
              <div class="eyebrow-row">
                <span>{CC_TAGLINE}</span>
              </div>
              <h1>3C得九</h1>
              <p class="lead">{CC_HERO_SUB}</p>
              <div class="cta-row">
                <a class="btn btn-light" href="/notes">翻翻人生随笔 →</a>
                <a class="btn btn-outline" href="/family">吉光片羽</a>
              </div>
            </div>
            <figure class="hero-photo">
              <img
                src="/images/family/family-01.jpg"
                alt="程成、珊珊与九儿的第一张正式合影"
                width="539"
                height="720"
              />
              <figcaption>一家三口的第一张正式合影</figcaption>
              <span class="stamp" set:html={sealBaiwen} aria-hidden="true"></span>
            </figure>
          </div>
        </div>
      </section>

      <!-- 户型图 / 房间 -->
      <section class="section">
        <div class="wrap">
          <span class="eyebrow">这间屋子</span>
          <h2 class="section-title">五个房间</h2>
          <p class="section-sub">不是户型图，是这一年的生活重心。点进去，看我在每个房间里做什么。</p>
          <div class="rooms">
            {CC_ROOMS.map((r) => (
              <a class="room" href={r.href}>
                <span class="room-name">{r.name}</span>
                <span class="room-desc">{r.desc}</span>
                <span class="room-arrow">→</span>
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- 最近在写（书房的已有文章导流） -->
      <section class="section" style="background:var(--surface);border-top:1px solid var(--border);border-bottom:1px solid var(--border);">
        <div class="wrap">
          <span class="eyebrow">书房 · 人生随笔</span>
          <h2 class="section-title">最近在写</h2>
          <p class="section-sub">生活、育儿、与自己较劲的那些时刻——多数首发于公众号「cc的奶爸日记」。</p>
          {
            ccNotes.length > 0 ? (
              <div class="posts">
                {ccNotes.map((w) => (
                  <a
                    class="post"
                    href={linkOf(w)}
                    target={isExternal(w) ? '_blank' : undefined}
                    rel={isExternal(w) ? 'noopener' : undefined}
                  >
                    <div>
                      <div class="meta">
                        {w.data.date.toISOString().slice(0, 10)} · {w.data.account}
                      </div>
                      <h3>{w.data.title}</h3>
                      <p>{w.data.excerpt}</p>
                    </div>
                    <div class="arrow">→</div>
                  </a>
                ))}
              </div>
            ) : (
              <p class="section-sub" style="margin-top:18px;">
                随笔正在整理，待补。先去 <a href="/family">吉光片羽</a> 看看。
              </p>
            )
          }
          <div style="margin-top:24px;display:flex;gap:14px;flex-wrap:wrap;">
            <a class="btn btn-ghost" href="/notes">全部人生随笔 →</a>
            {ccLibCount > 0 && <a class="btn btn-ghost" href="/library">音书影路（{ccLibCount}）→</a>}
          </div>
        </div>
      </section>

      <!-- ABOUT TEASER (cc) -->
      <section class="section">
        <div class="wrap">
          <div class="about-teaser ta-cc">
            <div class="prose">
              <span class="eyebrow">关于我</span>
              <h2 class="section-title">顾家，是真正的主业</h2>
              <p>
                九儿父母，是我的第一身份——其次，都是其次。这里不谈获客，只记录一个父亲、丈夫、
                和仍在修行的人，怎么把日子过明白。
              </p>
              <a class="btn btn-primary" href="/about">更多关于我 →</a>
            </div>
          </div>
        </div>
      </section>
    </BaseLayout>
  )
}

<style>
  /* ── .cc：全家福（宣纸相框 + 朱砂落款印） ── */
  .hero-photo {
    position: relative;
    margin: 0;
    width: 300px;
    padding: 12px 12px 0;
    background: #fffdf7;
    border: 1px solid rgba(43, 38, 32, 0.16);
    box-shadow: 0 18px 44px rgba(43, 38, 32, 0.18);
  }
  .hero-photo img {
    width: 100%;
    height: auto;
    display: block;
    filter: saturate(0.95) contrast(1.02);
  }
  .hero-photo figcaption {
    padding: 10px 0 12px;
    text-align: center;
    font-size: 12px;
    letter-spacing: 0.1em;
    color: var(--muted);
  }
  .hero-photo .stamp {
    position: absolute;
    right: -16px;
    bottom: -16px;
    width: 46px;
    height: 46px;
    opacity: 0.94;
    filter: drop-shadow(0 3px 8px rgba(43, 38, 32, 0.28));
  }
  .stamp :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* ── .cc：五个房间「户型图」 ── */
  .rooms {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
    margin-top: 8px;
  }
  .room {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 22px 20px;
    border-radius: 14px;
    background: var(--surface);
    border: 1px solid var(--border);
    text-decoration: none;
    color: var(--ink);
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
    position: relative;
  }
  .room:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 24px rgba(43, 38, 32, 0.08);
    border-color: rgba(179, 67, 47, 0.34);
  }
  .room-name {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--ink);
    letter-spacing: 0.06em;
  }
  .room-desc {
    font-size: 0.92rem;
    color: var(--muted);
    line-height: 1.7;
  }
  .room-arrow {
    position: absolute;
    right: 18px;
    top: 18px;
    color: var(--accent, #b3432f);
    font-size: 1.1rem;
  }
  .hero-cc .lead {
    font-size: 1.05rem;
    margin-top: 10px;
  }
  /* .cc 的「关于我」无头像，需单栏铺开（否则被 160px 首列压窄） */
  .about-teaser.ta-cc { grid-template-columns: 1fr; }

  @media (max-width: 820px) {
    .hero-photo { width: min(300px, 78vw); margin: 10px auto 0; }
    .hero-photo .stamp { right: -10px; bottom: -10px; width: 40px; height: 40px; }
  }
</style>
