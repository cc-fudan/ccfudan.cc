---
import BaseLayout from '../layouts/BaseLayout.astro';
const edu = [
  '2013 新洲一中理科火箭班，湖北省理科高考前 130 名',
  '2014 理转文，转入复旦国学班',
  '2017 复旦哲学学院学士，本院读研',
  '2020 复旦哲学学院硕士',
];
const career = [
  '2020 华为消费者业务管培生',
  '2021–2024 荣耀 渠道经理 / 地市经理 / 产品经理 / 零售经理',
  '2024–2025 能良电商 湖南省总经理（年采购约 8 亿）',
  '2025.10 裸辞，回家陪孕 & 陪产',
  '2025.10–2026 探索年：陪产带娃为主线，保险 / 法律 / 自媒体 / AI 多线并行',
  '2025.11 加入明亚，成为保险经纪人',
  '2026 香港高才通获批，拓展跨境身份与港险规划',
  '2026 律所实习探索中，深化法律实务',
  '2026.06 喜得小犬（程乐鱼）',
];
const method = [
  ['① 先定义问题', '哲学训练：把模糊的焦虑拆成可以回答的具体问题。'],
  ['② 划定边界', '法律训练：哪些能做、哪些不能碰，红线先立好。'],
  ['③ 对冲风险', '保险与身份规划：给不确定的未来装上确定性。'],
  ['④ 放大效率', 'AI 实战：让工具干活，把判断力留给人。'],
];
---

<BaseLayout title="关于我 | cc · 程成" description="程成（cc），独立咨询顾问。复旦哲学硕士、法律职业资格、前华为荣耀销售管理、前电商省总；明亚保险经纪人，香港高才通。">
  <section class="section">
    <div class="wrap prose">
      <div class="about-head">
        <div class="about-intro">
          <span class="eyebrow">关于我</span>
          <h1 class="section-title">程成（cc）</h1>
          <p style="font-size:18px;color:var(--ink);">
            独立咨询顾问 · 明亚保险经纪人 · 保诚港险代理人。<br />
            哲学拆问题，法律划边界，保险兜风险，AI 提效率。
          </p>

          <div class="tag-row">
            <span class="tag">复旦中哲本硕</span>
            <span class="tag">华为荣耀管培</span>
            <span class="tag">某电商前省总</span>
            <span class="tag">香港高才</span>
            <span class="tag">独立保险经纪人</span>
          </div>
        </div>
        <img class="about-avatar" src="/images/avatar.jpg" alt="程成 cc 头像" width="220" height="220" />
      </div>

      <h2>我是谁</h2>
      <div class="verse">
        <p>君子有三乐，有九思；</p>
        <p>复旦中哲の本硕，华为荣耀管培生；</p>
        <p>能良电商前省总，裸辞转行的奶爸；</p>
        <p>独立保险中介人，保险行业小人物；</p>
        <p>韭菜保护爱好者，家庭资产保险丝；</p>
        <p>热爱佛学红楼梦，沉迷 AI &amp; 自媒体。</p>
      </div>
      <p>
        1995 年生于湖北武汉新洲。从理科火箭班到复旦国学班，再到中国哲学，一路"理转文"。
        2025 年为陪产回归家庭，也把"给自家配保险"做成了终身职业的起点。
      </p>
      <p>
        现在我的身份是<strong>独立咨询顾问</strong>：客户的问题在哪，我的工具箱就开在哪——
        保险、法律、身份、职业、AI，都只是工具，用哪个，取决于你真正需要什么。
      </p>

      <h2>为什么是「顾问」，不是「销售」</h2>
      <p>
        <strong>判断力。</strong>AI 时代，执行力正在被商品化，稀缺的是判断力——哲学训练我拆问题，
        法考训练我划边界，五年一线操盘（4 年消费电子 + 1 年电商省总）训练我看业务。这三样叠加，是我敢说"把复杂的事拆清楚"的底气。
      </p>
      <p>
        <strong>信任。</strong>销售的目标是成交，顾问的目标是你的问题被解决。
        我不属于任何一家保险公司，不用话术留人，不怕说"这个你其实不用买"。
      </p>
      <p>
        <strong>在乎。</strong>AI 能模拟专业，模拟不了在乎。好顾问不是因为用了正确的方法，
        而是真的在乎你有没有被安排好。这是我做这行的底线，也是天花板。
      </p>

      <h2>我的方法：四步</h2>
      <div class="grid-2" style="margin-top:14px;">
        {method.map(([t, d]) => (
          <div class="card">
            <h3>{t}</h3>
            <p>{d}</p>
          </div>
        ))}
      </div>

      <h2>履历</h2>
      <h3 style="font-size:16px;color:var(--muted);margin:18px 0 8px;">教育</h3>
      <ul>{edu.map((e) => <li>{e}</li>)}</ul>
      <h3 style="font-size:16px;color:var(--muted);margin:22px 0 8px;">职业</h3>
      <ul>{career.map((c) => <li>{c}</li>)}</ul>

      <h2>裸辞这一年：我的探索年</h2>
      <p>
        2025 年 10 月裸辞，不是"换一份工作"，而是把最近一年当作一次多元探索——
        <strong>主线是陪产带娃</strong>，副业探索和兴趣自媒体同时铺开。把想试的事都实地试了一遍，
        价值只有一个：<strong>顾问的判断力不是读出来的，是试出来的</strong>。
      </p>
      <div class="grid-2" style="margin-top:14px;">
        <div class="card">
          <h3>🍼 陪产带娃（主线）</h3>
          <p>2026.06 喜得小犬。这是探索年的主线，也是所有选择的前提。</p>
        </div>
        <div class="card">
          <h3>🛡 港险 · 明亚</h3>
          <p>保诚港险代理人 + 明亚保险经纪人，内地与香港两套保障体系都亲历实操。</p>
        </div>
        <div class="card">
          <h3>⚖️ 律所实习 · 5 个案例</h3>
          <p>法律实务从纸面走到现场，法考 A 证开始兑现。</p>
        </div>
        <div class="card">
          <h3>🏢 海南公司 · 武汉豪宅销售</h3>
          <p>公司架构与高净值客户需求逻辑的一线观察。</p>
        </div>
        <div class="card">
          <h3>💼 能良咨询 · 2000 元/小时</h3>
          <p>把五年操盘经验第一次定价——验证专业服务的市场价值。</p>
        </div>
        <div class="card">
          <h3>✍️ 公众号 ×4 · 视频号 · 直播 4 场</h3>
          <p>内容即信任的前置过滤，自媒体是顾问的第二张名片。</p>
        </div>
        <div class="card">
          <h3>🤖 AI 工具 · 知识库</h3>
          <p>AI 协作实战——你现在看的这个网站，就是人机协作的产物。</p>
        </div>
        <div class="card">
          <h3>🧭 这一年证明了什么</h3>
          <p>不是样样都做成，而是每一条路的深浅、坑在哪，都亲手摸过了——这就是顾问判断力的来源。</p>
        </div>
      </div>

      <h2>一些瞬间</h2>
      <div class="gallery">
        <img src="/images/scene-1.jpg" alt="一家三口 · 喜得小犬（程乐鱼）" />
        <img src="/images/scene-2.jpg" alt="陪产时光 · 期待新生命" />
        <img src="/images/scene-3.jpg" alt="我爸爸 / 我妈妈" />
        <img src="/images/scene-4.jpg" alt="一起等宝宝来" />
      </div>

      <h2>为什么入行保险</h2>
      <p>
        不是想找副业，也不是走投无路。真实原因是：打算给自己和家庭配置保险，接触一圈发现，
        外面卖保险的代理人大多不太专业——要么只会背话术，要么只推自家一家公司的产品。
        我在华为荣耀做过四年销售管理，知道什么叫"以客户为中心"；加上哲学训练出的底层逻辑和法考的法律基础，
        我觉得这件事我可以做得比大多数人好。与其让别人给我配，不如我自己来。
      </p>
      <p>
        做着做着发现，客户的问题从来不只有保险：婚姻财产怎么约定、孩子身份怎么规划、职业岔路口怎么选、
        AI 到底怎么用——于是我把自己升级成了<strong>顾问</strong>，保险只是四张地图里的第一张。
      </p>

      <h2>约法三章</h2>
      <div class="rules" style="margin-top:14px;">
        <div class="rule">
          <div class="n">一</div>
          <h4>不卖我不认可的产品</h4>
          <p>无论耳熟能详的大公司，还是没听过的小保司。</p>
        </div>
        <div class="rule">
          <div class="n">二</div>
          <h4>不用我不认可的方式</h4>
          <p>无套路、不话术、不骚扰。人不找我，我不找人。</p>
        </div>
        <div class="rule">
          <div class="n">三</div>
          <h4>不卖给不互信的人</h4>
          <p>托付是长期的，先彼此信任，再谈方案。</p>
        </div>
      </div>

      <div style="margin-top:34px;">
        <a class="btn btn-primary" href="/contact">加微信聊聊 →</a>
      </div>
    </div>
  </section>
</BaseLayout>
